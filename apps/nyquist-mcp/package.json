{
  "name": "nyquist-mcp",
  "version": "0.2.0",
  "description": "MCP server that gives an autonomous agent its own Ethereum wallet. The keys stay on the agent's machine.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ethereum",
    "wallet",
    "safe",
    "agent"
  ],
  "homepage": "https://www.nyquist.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osaxyz/nyquist.git",
    "directory": "apps/nyquist-mcp"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "nyquist-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
