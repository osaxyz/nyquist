    "dev": "tsx src/index.ts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@nyquist/agent": "workspace:*",
    "@nyquist/tsconfig": "workspace:*",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  }
